{
  "name": "@cf-chat/widget-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/widget.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/widget.css --minify && node scripts/shadow-css.cli.ts dist/widget.css",
    "build:js": "node scripts/build.ts",
    "build": "pnpm build:css && pnpm build:js",
    "preview": "pnpm build:css && esbuild preview/main.tsx --bundle --format=esm --platform=browser --target=es2022 --jsx=automatic --loader:.css=text --outdir=preview/dist --servedir=preview --serve=127.0.0.1:8790"
  },
  "dependencies": {
    "@cf-chat/shared": "workspace:*",
    "@ai-sdk/react": "4.0.96",
    "agents": "0.22.0",
    "ai": "7.0.93",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "26.4.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.4",
    "esbuild": "0.28.2",
    "happy-dom": "20.0.11",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
